# AutoRadar — єдиний env-файл для всіх сервісів
# cp .env.example .env

# ── Backend ──────────────────────────────────────────────────────────────────
# Локально: DEBUG=true дозволяє дефолтні секрети.
# Production (FRONTEND_URL=https://...): обов'язково DEBUG=false і сильні секрети:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEBUG=true
# SQLite у папці database/
DATABASE_URL=sqlite+aiosqlite:///database/autoradar.db
# KV — локально і в Docker за замовчуванням sqlite (стабільно).
# Redis (опційно): docker compose --profile cache up -d
#   KV_URL=redis://redis:6379/0
REDIS_URL=sqlite://database/kv.db
KV_URL=sqlite://database/kv.db
# Масштаб: docker compose --profile scale up -d
# DATABASE_URL=postgresql+asyncpg://carbit:carbit@postgres:5432/carbit
# UVICORN_WORKERS=2
SECRET_KEY=change-me-in-production

# OpenAI (голосовий пошук у кабінеті — /app/search, /app/dashboard)
OPENAI_API_KEY=

# TurboSMS (реєстрація по телефону + SMS-fallback при вході)
# turbo_sms_token=...   # legacy alias
TURBOSMS_TOKEN=
TURBOSMS_SENDER=Carbit   # має бути активований у кабінеті turbosms.ua

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=AutoRadar <info@13vplus.com>
FRONTEND_URL=http://localhost:3000

# OAuth (redirect URI додайте в Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# External APIs
# Ключ з developers.ria.com (30 запитів/год на free tier)
AUTO_RIA_API_KEY=
# Публічний API Імперія Авто — https://api.imperiya-auto.com.ua/api/v2/docs
IMPERIYA_API_KEY=
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=

# База ДАІ — перевірка VIN (https://baza-gai.com.ua/api), 1000 req/міс на free
BAZA_GAI_API_KEY=
BAZA_GAI_BASE_URL=https://baza-gai.com.ua

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Internal API (bot → backend, має збігатися в обох сервісах)
INTERNAL_API_SECRET=change-me-internal

# ── Telegram Bot ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# @username бота (без @) — використовується backend, bot і frontend
TELEGRAM_BOT_USERNAME=
# Необов'язково: повне посилання t.me/... (якщо порожньо — збирається з username)
TELEGRAM_BOT_URL=

# Публічний URL API для браузера.
# Локально / простий Docker: відносний шлях через Next rewrite:
NEXT_PUBLIC_API_URL=/api/v1
# Надійніше на проді (без Next як SPOF): абсолютний URL backend + CORS
# NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1
# або той самий хост з окремим reverse-proxy на :8000
# НЕ використовуйте http://backend:8000 — це внутрішня адреса Docker.
BACKEND_URL=http://localhost:8000/api/v1

# Observability (опційно)
# SENTRY_DSN=https://...@sentry.io/...

# LiqPay: sandbox_… = тест; без префікса = бойові платежі
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=

# ── Строк зберігання оголошень ────────────────────────────────────────────────
# Старші видаляються з БД разом із фото; Telegram їх навіть не сканує.
LISTING_MAX_AGE_DAYS=120

# ── Telegram Parser (Telethon user client) ────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_MAX_PHOTOS=1
TELEGRAM_MEDIA_MAX_WIDTH=1280
TELEGRAM_MEDIA_JPEG_QUALITY=82
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_NUMBER=
# Ім'я файлу сесії: database/<TELETHON_SESSION_NAME>.session
# Локально й на сервері ставте РІЗНІ назви — один акаунт не може тримати
# одну .session одночасно в двох місцях (AuthKeyDuplicatedError).
# Приклад локально: carbit_parser_local
# Приклад на VPS:   carbit_parser
TELETHON_SESSION_NAME=carbit_parser_local

# ── Docker (production) ──────────────────────────────────────────────────────
# Публічний URL сайту для OG/Twitter preview (build-time для frontend)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Якщо не задано — береться FRONTEND_URL або https://carbit.info
# BACKEND_URL=https://your-domain.com/api/v1
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/google/callback
# FRONTEND_PORT=3000
# BACKEND_PORT=8000
#
# Масштаб (Postgres + Redis):
#   docker compose --profile cache --profile scale up -d
#   DATABASE_URL=postgresql+asyncpg://carbit:carbit@postgres:5432/carbit
#   KV_URL=redis://redis:6379/0
#   REDIS_URL=redis://redis:6379/0
# Детальні інструкції: DOCKER.md
